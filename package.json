{
  "name": "spectacle",
  "version": "0.1.0",
  "private": true,
  "description": "Spectacle — a massively multiplayer strand-drawing game on hexagon and Spectre tilings",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "concurrently -k -n server,client \"BOTS=1 npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --port 5173",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bench:field": "tsx scripts/bench-field.ts",
    "bench:lag": "tsx scripts/lag-bench.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.7"
  }
}
