# Copied to /opt/spectacle/.env by startup.sh (edit it there, then `docker compose up -d`).
BOTS=1
FIELD_FAMILY=hex
FIELD_LEVEL=5
# This one small VM is a single process with a 512m container limit (see
# docker-compose.yml) — there is no scaling out to do here. Keep this low
# enough that the process refuses new joins cleanly well before it would run
# the VM out of memory; a Docker OOM-kill drops every connected player, a
# refusal only turns away the next one (who still sees the "play solo"
# offer). Raise it only alongside more memory. See README.md's "Scaling for
# a surge" — for real traffic, Cloud Run (deploy/gcp/cloudrun.sh) is the path.
MAX_INSTANCE_PLAYERS=200
# /patterns (rules played and their scores) is always on; STATS_FILE persists
# it across restarts. docker-compose.yml sets it to /data/pattern-stats.json on
# a volume, so it survives Watchtower's updates too.
# Any knob from shared/game/knobs.ts, e.g.
# KNOB_BASE_STEP_MS=400
# KNOB_SPEED_PER_POINT=0.005
# KNOB_CROSSING_MODE=geometric
# Hot-loaded bot brains (server/brains.ts): new bot code without a restart.
# The VM's service account needs read access to the bucket. Unset = off.
# BOTS_URL=gs://YOUR-PROJECT-spectacle-brains/brains
# Player feedback (server/feedback.ts, docs/feedback-agent.md): where POST
# /feedback keeps reports for the triage workflow. The VM's service account
# needs storage.objectCreator on the bucket. Unset = the feedback form offers
# a GitHub issue instead.
# FEEDBACK_URL=gs://YOUR-PROJECT-spectacle-feedback
